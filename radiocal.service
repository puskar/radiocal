[Unit]
Description=Radio Calendar service
After=network.target
StartLimitIntervalSec=0
[Service]
Type=simple
Restart=always
RestartSec=1
User=puskar
WorkingDirectory=/home/puskar/workspace/github/puskar/radiocal
ExecStart=/home/puskar/.local/bin/uv run --with gunicorn gunicorn --access-logfile - --error-logfile - --bind 0.0.0.0:8090 main:app
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
