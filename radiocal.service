[Unit]
Description=WOBC Calendar service
After=network.target
StartLimitIntervalSec=0
[Service]
Type=simple
Restart=always
RestartSec=1
User=puskar
ExecStart=/home/puskar/radiocal/.venv/bin/python /home/puskar/radiocal/radiocal.py
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
